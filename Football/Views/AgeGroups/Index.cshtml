@model IEnumerable<Football.Models.AgeGroup>

@{
    ViewData["Title"] = "Age Groups";
    var groups = Model.ToList();
}

<div class="container py-5">

    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-3 mb-4">
        <div>
            <span class="text-uppercase text-primary fw-semibold small">
                Football Academy / Management
            </span>
            <h2 class="fw-bold mt-2 mb-1">Age Groups</h2>
            <p class="text-muted mb-0">
                Organize players into age-based training categories.
            </p>
        </div>

        <a asp-controller="AgeGroups"
           asp-action="Create"
           class="btn btn-primary rounded-3 px-4 py-2 shadow-sm">
            <i class="bi bi-plus-circle me-2"></i>
            Add Age Group
        </a>
    </div>

    <!-- Statistics -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 shadow-sm rounded-4 h-100">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <div>
                            <p class="text-muted mb-2">Total Age Groups</p>
                            <h2 class="fw-bold mb-0">@groups.Count</h2>
                        </div>
                        <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                            <i class="bi bi-people-fill fs-3"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Table -->
    <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

        <div class="card-header bg-white border-0 p-4">
            <h5 class="fw-bold mb-1">Age Groups Directory</h5>
            <p class="text-muted small mb-0">
                Manage all registered academy age categories.
            </p>
        </div>

        <div class="table-responsive academy-table-wrap">
            <table class="table table-hover align-middle mb-0 academy-table">
                <thead class="table-light">
                    <tr>
                        <th scope="col" class="ps-4 py-3">Age Group</th>
                        <th scope="col">Minimum Age</th>
                        <th scope="col">Maximum Age</th>
                        <th scope="col">Age Range</th>
                        <th scope="col" class="text-center">Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var group in groups)
                    {
                        <tr>
                            <td class="ps-4 py-3">
                                <div class="d-flex align-items-center gap-3">
                                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3">
                                        <i class="bi bi-people"></i>
                                    </div>
                                    <div>
                                        <div class="fw-semibold">@group.Name</div>
                                        <small class="text-muted">Academy category</small>
                                    </div>
                                </div>
                            </td>

                            <td>@group.MinAge years</td>
                            <td>@group.MaxAge years</td>

                            <td>
                                <span class="badge rounded-pill bg-success bg-opacity-10 text-success px-3 py-2">
                                    @group.MinAge - @group.MaxAge years
                                </span>
                            </td>

                           
                            <td class="text-end pe-4">
                                <div class="d-flex justify-content-end gap-2">

                                    <a asp-controller="AgeGroups"
                                       asp-action="Edit"
                                       asp-route-id="@group.Id"
                                       class="btn btn-sm btn-outline-primary app-row-action"
                                       title="Edit" aria-label="Edit"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                    <a asp-controller="AgeGroups"
                                       asp-action="Delete"
                                       asp-route-id="@group.Id"
                                       class="btn btn-sm btn-outline-danger app-row-action"
                                       title="Delete" aria-label="Delete"><i class="bi bi-trash" aria-hidden="true"></i></a>
</div>
                            </td>

                        </tr>

                    }
                </tbody>
            </table>
        </div>

        @if (!groups.Any())
        {
            <div class="text-center py-5">
                <i class="bi bi-inboxes fs-1 text-muted"></i>
                <h5 class="fw-bold mt-3">No Age Groups Found</h5>
                <p class="text-muted">
                    Create your first age group to get started.
                </p>
                <a asp-action="Create" class="btn btn-primary rounded-3"><i class="bi bi-plus-circle me-2" aria-hidden="true"></i>
                    Create Age Group
                </a>
            </div>
        }

    </div>
</div>
