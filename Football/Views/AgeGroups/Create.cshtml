
@model Football.Models.AgeGroup

@{
    ViewData["Title"] = "Create Age Group";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <!-- Breadcrumb -->
            <div class="mb-4">
                <a asp-action="Index"
                   class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-1"></i>
                    Back to Age Groups
                </a>

                <h2 class="fw-bold mt-3 mb-1">
                    Create Age Group
                </h2>

                <p class="text-muted">
                    Define a new age category for academy players.
                </p>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <!-- Card Header -->
                <div class="card-header bg-primary text-white border-0 p-4">
                    <div class="d-flex align-items-center gap-3">
                        <div class="bg-white bg-opacity-25 rounded-3 p-3">
                            <i class="bi bi-people-fill fs-3"></i>
                        </div>

                        <div>
                            <h5 class="fw-bold mb-1">
                                Age Group Information
                            </h5>
                            <p class="mb-0 small text-white-50">
                                Fill in the details below.
                            </p>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">

                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <!-- Name -->
                        <div class="mb-4">
                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                                Age Group Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control form-control-lg rounded-3"
                                   placeholder="e.g. Under 12 (U12)" />

                            <span asp-validation-for="Name"
                                  class="text-danger small"></span>

                            <div class="form-text">
                                Use a clear name to identify this category.
                            </div>
                        </div>

                        <!-- Age Range -->
                        <div class="row g-3 mb-4">

                            <div class="col-md-6">
                                <label asp-for="MinAge"
                                       class="form-label fw-semibold">
                                    Minimum Age
                                </label>

                                <div class="input-group">
                                    <input asp-for="MinAge"
                                           type="number"
                                           min="1"
                                           max="100"
                                           class="form-control form-control-lg rounded-start-3" />

                                    <span class="input-group-text">
                                        Years
                                    </span>
                                </div>

                                <span asp-validation-for="MinAge"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MaxAge"
                                       class="form-label fw-semibold">
                                    Maximum Age
                                </label>

                                <div class="input-group">
                                    <input asp-for="MaxAge"
                                           type="number"
                                           min="1"
                                           max="100"
                                           class="form-control form-control-lg rounded-start-3" />

                                    <span class="input-group-text">
                                        Years
                                    </span>
                                </div>

                                <span asp-validation-for="MaxAge"
                                      class="text-danger small"></span>
                            </div>

                        </div>

                        <!-- Information -->
                        <div class="alert alert-info border-0 rounded-3 mb-4">
                            <i class="bi bi-info-circle me-2"></i>
                            Minimum age must be less than or equal to maximum age.
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-end gap-3">
                            <a asp-action="Index"
                               class="btn btn-outline-secondary border rounded-3 px-4"><i class="bi bi-arrow-left me-2" aria-hidden="true"></i>
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary rounded-3 px-4">
                                <i class="bi bi-check-circle me-2"></i>
                                Save Age Group
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
