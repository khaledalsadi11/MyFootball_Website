
@model Football.Models.AgeGroup

@{
    ViewData["Title"] = "Edit Age Group";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">

            <div class="mb-4">
                <a asp-action="Index"
                   class="text-decoration-none text-muted small">
                    <i class="bi bi-arrow-left me-2"></i>
                    Back to Age Groups
                </a>

                <h2 class="fw-bold mt-3">Edit Age Group</h2>
                <p class="text-muted">
                    Update the age category information.
                </p>
            </div>

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <div class="card-header bg-primary text-white p-4 border-0">
                    <div class="d-flex align-items-center gap-3">
                        <i class="bi bi-pencil-square fs-2"></i>
                        <div>
                            <h5 class="fw-bold mb-1">Edit Category</h5>
                            <small>Update age group details</small>
                        </div>
                    </div>
                </div>

                <div class="card-body p-4 p-md-5">

                    <form asp-action="Edit"
                          asp-route-id="@Model.Id"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input asp-for="Id" type="hidden" />

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        <div class="mb-4">
                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                                Age Group Name
                            </label>

                            <input asp-for="Name"
                                   class="form-control form-control-lg rounded-3" />

                            <span asp-validation-for="Name"
                                  class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="MinAge"
                                       class="form-label fw-semibold">
                                    Minimum Age
                                </label>

                                <input asp-for="MinAge"
                                       type="number"
                                       min="1"
                                       max="100"
                                       class="form-control form-control-lg rounded-3" />

                                <span asp-validation-for="MinAge"
                                      class="text-danger small"></span>
                            </div>

                            <div class="col-md-6">
                                <label asp-for="MaxAge"
                                       class="form-label fw-semibold">
                                    Maximum Age
                                </label>

                                <input asp-for="MaxAge"
                                       type="number"
                                       min="1"
                                       max="100"
                                       class="form-control form-control-lg rounded-3" />

                                <span asp-validation-for="MaxAge"
                                      class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="alert alert-info border-0 rounded-3">
                            <i class="bi bi-info-circle me-2"></i>
                            Minimum age must not exceed maximum age.
                        </div>

                        <div class="d-flex justify-content-end gap-3 mt-4">
                            <a asp-action="Index"
                               class="btn btn-outline-secondary border rounded-3 px-4"><i class="bi bi-arrow-left me-2" aria-hidden="true"></i>
                                Cancel
                            </a>

                            <button type="submit"
                                    class="btn btn-primary rounded-3 px-4">
                                <i class="bi bi-check-circle me-2"></i>
                                Save Changes
                            </button>
                        </div>

                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
