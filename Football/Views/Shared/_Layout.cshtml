@{
    var currentController = ViewContext.RouteData.Values["controller"]?.ToString();
    var navigationItems = new[]
    {
        new { Controller = "Dashboard", Label = "Dashboard", Icon = "bi-grid-1x2" },
        new { Controller = "Clubs", Label = "Clubs", Icon = "bi-shield" },
        new { Controller = "Players", Label = "Players", Icon = "bi-people" },
        new { Controller = "AgeGroups", Label = "Age Groups", Icon = "bi-collection" },
        new { Controller = "Teams", Label = "Teams", Icon = "bi-diagram-3" },
        new { Controller = "Coaches", Label = "Coaches", Icon = "bi-person-badge" },
        new { Controller = "TrainingSessions", Label = "Training Sessions", Icon = "bi-calendar-event" },
        new { Controller = "Attendances", Label = "Attendance", Icon = "bi-clipboard-check" }
    };
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Football</title>
    <link rel="icon" type="image/svg+xml" href="~/images/football-mark.svg" />

    <!-- Bootstrap CSS -->
    <link rel="stylesheet"
          href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

    <!-- Bootstrap Icons -->
    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css" />

    <!-- Toastr CSS -->
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css" />

    <!-- Project CSS -->
    <link rel="stylesheet"
          href="~/css/site.css"
          asp-append-version="true" />

    <link rel="stylesheet"
          href="~/Football.styles.css"
          asp-append-version="true" />

    <link rel="stylesheet" href="~/css/green-theme.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/tables.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>

<body class="app-body">
    <a class="app-skip-link" href="#main-content">Skip to content</a>
    <div class="app-mobile-bar d-lg-none">
        <a class="app-mobile-brand" asp-area="" asp-controller="Dashboard" asp-action="Index"><partial name="_FootballLogo" /></a>
        <button type="button" class="app-menu-toggle" data-bs-toggle="offcanvas" data-bs-target="#appSidebar" aria-controls="appSidebar" aria-label="Open navigation"><i class="bi bi-list" aria-hidden="true"></i></button>
    </div>
    <aside class="offcanvas-lg offcanvas-start app-sidebar" tabindex="-1" id="appSidebar" aria-labelledby="sidebarBrand">
        <div class="app-sidebar-heading">
            <a id="sidebarBrand" class="app-sidebar-brand" asp-area="" asp-controller="Dashboard" asp-action="Index"><partial name="_FootballLogo" /></a>
            <button type="button" class="app-sidebar-close d-lg-none" data-bs-dismiss="offcanvas" data-bs-target="#appSidebar" aria-label="Close navigation"><i class="bi bi-x-lg" aria-hidden="true"></i></button>
        </div>
        <div class="offcanvas-body app-sidebar-body">
            <nav class="app-navigation" aria-label="Main navigation">
                <p class="app-nav-label">WORKSPACE</p>
                @foreach (var item in navigationItems.Take(3))
                {
                    <a class="app-nav-link @(currentController == item.Controller ? "active" : "")" asp-area="" asp-controller="@item.Controller" asp-action="Index" aria-current="@(currentController == item.Controller ? "page" : null)"><i class="bi @item.Icon" aria-hidden="true"></i><span>@item.Label</span>@if (currentController == item.Controller) { <span class="app-nav-dot" aria-hidden="true"></span> }</a>
                }
                <p class="app-nav-label">ACADEMY</p>
                @foreach (var item in navigationItems.Skip(3).Take(3))
                {
                    <a class="app-nav-link @(currentController == item.Controller ? "active" : "")" asp-area="" asp-controller="@item.Controller" asp-action="Index" aria-current="@(currentController == item.Controller ? "page" : null)"><i class="bi @item.Icon" aria-hidden="true"></i><span>@item.Label</span>@if (currentController == item.Controller) { <span class="app-nav-dot" aria-hidden="true"></span> }</a>
                }
                <p class="app-nav-label">TRAINING</p>
                @foreach (var item in navigationItems.Skip(6))
                {
                    <a class="app-nav-link @(currentController == item.Controller ? "active" : "")" asp-area="" asp-controller="@item.Controller" asp-action="Index" aria-current="@(currentController == item.Controller ? "page" : null)"><i class="bi @item.Icon" aria-hidden="true"></i><span>@item.Label</span>@if (currentController == item.Controller) { <span class="app-nav-dot" aria-hidden="true"></span> }</a>
                }
            </nav>
            <div class="app-sidebar-account">
                <partial name="_LoginPartial" />
            </div>
            <div class="app-sidebar-caption"><span class="app-status-dot"></span> Every role. One team.</div>
        </div>
    </aside>
    <div class="app-workspace">
        <main id="main-content" class="app-main" tabindex="-1">
            @RenderBody()
        </main>
        <footer class="app-footer">
            <span><strong>Football</strong> <span class="app-footer-description">/ Football Academy Management</span></span>
            <span>&copy; @DateTime.Now.Year Football</span>
        </footer>
    </div>
    <!-- jQuery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- Bootstrap JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <!-- Project JS -->
    <script src="~/js/site.js"
            asp-append-version="true"></script>

    <!-- TOASTR NOTIFICATIONS -->
    @if (TempData["s"] is string successMessage)
    {
        <script>
            toastr.success(
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(successMessage))
            );
        </script>
    }

    @if (TempData["errorData"] is string errorMessage)
    {
        <script>
            toastr.error(
                @Html.Raw(System.Text.Json.JsonSerializer.Serialize(errorMessage))
            );
        </script>
    }

    <!-- PAGE-SPECIFIC SCRIPTS -->
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>
