
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - Football</title>

    <script type="importmap"></script>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Football.styles.css" asp-append-version="true" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.2/font/bootstrap-icons.min.css" />
</head>

<body class="d-flex flex-column min-vh-100">

    <header>
        <nav class="navbar navbar-expand-lg navbar-dark football-navbar">
            <div class="container">

                <a class="navbar-brand fw-bold fs-4 d-flex align-items-center gap-2"
                   asp-controller="Home"
                   asp-action="Index">
                    <i class="bi bi-dribbble"></i>
                    FootBall
                </a>

                <button class="navbar-toggler"
                        type="button"
                        data-bs-toggle="collapse"
                        data-bs-target="#footballNavbar"
                        aria-controls="footballNavbar"
                        aria-expanded="false"
                        aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="collapse navbar-collapse" id="footballNavbar">

                    <ul class="navbar-nav ms-lg-4 me-auto">

                        <li class="nav-item">
                            <a class="nav-link px-3"
                               asp-controller="Home"
                               asp-action="Index">
                                Home
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3"
                               asp-controller="Clubs"
                               asp-action="Index">
                                Clubs
                            </a>
                        </li>

                        <li class="nav-item">
                            <a class="nav-link px-3"
                               asp-controller="Players"
                               asp-action="Index">
                                Players
                            </a>
                        </li>

                    </ul>

                    <form class="d-flex mt-3 mt-lg-0"
                          asp-controller="Clubs"
                          asp-action="Index"
                          method="get">
                        <input class="form-control search-input"
                               type="search"
                               name="search"
                               placeholder="Search for a club..."
                               aria-label="Search" />

                        <button class="btn btn-primary ms-2"
                                type="submit"
                                aria-label="Search">
                            <i class="bi bi-search"></i>
                        </button>
                    </form>

                </div>
            </div>
        </nav>
    </header>

    <main role="main" class="flex-grow-1">
      
        @RenderBody()
    </main>

    <footer class="football-footer py-4 mt-5">
        <div class="container text-center">
            <p class="mb-0 text-secondary">
                <i class="bi bi-dribbble me-1"></i>
                Football &copy; @DateTime.Now.Year
                — Discover the World of Football
            </p>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)

    <style>
            .football-navbar {
                background: linear-gradient(90deg, #071d3a, #0b2e58);
                padding: 12px 0;
                box-shadow: 0 3px 12px rgba(0, 0, 0, 0.12);
            }

                .football-navbar .navbar-brand {
                    color: #fff;
                    letter-spacing: .3px;
                }

                    .football-navbar .navbar-brand i {
                        color: #38a1ff;
                        font-size: 1.7rem;
                    }

                .football-navbar .nav-link {
                    color: #e6edf7;
                    border-radius: 8px;
                    transition: background-color .2s ease;
                }

                    .football-navbar .nav-link:hover,
                    .football-navbar .nav-link:focus {
                        color: #fff;
                        background-color: #174b82;
                    }

            .search-input {
                min-width: 230px;
                border-radius: 25px;
            }

            .football-footer {
                border-top: 1px solid #e5edf6;
                background-color: #f8fbff;
            }

            @@media (max-width: 991.98px) {
                .search-input {
                    min-width: 0;
                    width: 100%;
                }
            }
    </style>

</body>
</html>
