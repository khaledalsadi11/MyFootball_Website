
@model IEnumerable<Football.Models.TrainingSession>

@{
    ViewData["Title"] = "Training Sessions";
}

<div class="container py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="fw-bold">Training Sessions</h2>

        <a asp-action="Create" class="btn btn-primary rounded-3 px-4 py-2 shadow-sm">
            <i class="bi bi-plus-circle me-2"></i>
            Add Session
        </a>
    </div>

    <div class="card shadow-sm border-0">
        <div class="card-body">
            <div class="table-responsive academy-table-wrap">
                <table class="table table-hover align-middle academy-table">
                    <thead class="table-light">
                        <tr>
                            <th scope="col">Title</th>
                            <th scope="col">Club</th>
                            <th scope="col">Team</th>
                            <th scope="col">Start</th>
                            <th scope="col">End</th>
                            <th scope="col">Location</th>
                            <th scope="col" class="text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var session in Model)
                        {
                            <tr>
                                <td>@session.Title</td>
                                <td>@(session.Team?.Club?.Name ?? "-")</td>
                                <td>@(session.Team?.Name ?? "-")</td>
                                <td>@session.StartTime.ToString("dd MMM yyyy HH:mm")</td>
                                <td>@session.EndTime.ToString("HH:mm")</td>
                                <td>@(session.Location ?? "-")</td>
                                <td>
                                    <div class="d-flex justify-content-center gap-2 flex-wrap">
                                    <a asp-action="Details"
                                       asp-route-id="@session.Id"
                                       class="btn btn-sm btn-outline-secondary app-row-action"
                                       title="Details" aria-label="Session details"><i class="bi bi-eye" aria-hidden="true"></i></a>
                                    <a asp-action="Edit"
                                       asp-route-id="@session.Id"
                                       class="btn btn-sm btn-outline-primary app-row-action"
                                       title="Edit" aria-label="Edit session"><i class="bi bi-pencil" aria-hidden="true"></i></a>
                                    <a asp-action="Delete"
                                       asp-route-id="@session.Id"
                                       class="btn btn-sm btn-outline-danger app-row-action"
                                       title="Delete" aria-label="Delete session"><i class="bi bi-trash" aria-hidden="true"></i></a>
</div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

            @if (!Model.Any())
            {
                <div class="text-center text-muted py-4">
                    No training sessions found.
                </div>
            }
        </div>
    </div>
</div>
