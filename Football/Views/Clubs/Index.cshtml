
@model IEnumerable<Club>
@{
    int count = 0;
}

<div class="container py-5">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-dark mb-1">Clubs List</h2>
            <p class="text-muted mb-0">Manage your football clubs</p>
        </div>

        <a asp-controller="Clubs"
           asp-action="Create"
           class="btn btn-primary px-4">
            <i class="bi bi-plus-square"></i> &nbsp; Add Club
        </a>
    </div>

    <div class="card border-0 shadow-sm rounded-4">
        <div class="card-body p-0">

            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">

                    <thead class="table-dark">
                        <tr>
                            <th class="py-3 ps-4">#</th>
                            <th class="py-3">Name</th>
                            <th class="py-3">League</th>
                            <th class="py-3">Created On</th>
                            <th class="py-3 text-center">Actions</th>
                        </tr>
                    </thead>

                    <tbody>
                        
                        @foreach (var club in Model)
                        {
                            count++;
                            <tr>
                                <td class="ps-4 text-muted">
                                    @count
                                </td>

                                <td>
                                    <span class="fw-semibold text-dark">
                                        @club.Name
                                    </span>
                                </td>

                                <td>
                                    <span class="badge bg-primary-subtle text-primary rounded-pill px-3 py-2">
                                        @club.league
                                    </span>
                                </td>

                                <td class="text-muted">
                                    @club.CreatedOn.ToString("dd MMM yyyy")
                                </td>

                                <td class="text-center">
                                    <a asp-controller="Clubs"
                                       asp-action="Edit"
                                       asp-route-Id="@club.Id"
                                       class="btn btn-sm btn-outline-primary me-1">
                                        <i class="bi bi-pencil-fill"></i> &nbsp; Edit
                                    </a>
                                    <a asp-controller="Clubs"
                                       asp-action="Delete"
                                       asp-route-Id="@club.Id"
                                       class="btn btn-sm btn-outline-primary me-1">
                                         Delete
                                    </a>
                                    <a asp-controller="Clubs"
                                       asp-action="Details"
                                       asp-route-Id="@club.Id"
                                       class="btn btn-sm btn-outline-secondary">
                                         &nbsp;Details
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

   

</div>
@{

    if (TempData["s"] != null)
    {
        <h2 style="color :navy ; margin-left :800px" class="border-danger">@TempData["s"]</h2>
    }


}