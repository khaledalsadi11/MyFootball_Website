@model Club;

<form method="post">


    <div class="border p-3 mt-4">

        <div>
            <h2>
                Delete Club
            </h2>
        </div>
        <hr>

        <div class="mb-3">
            <label asp-for="Name"></label>
            <input asp-for="Name" class="form-control" />
        </div>
        <div class="mb-3">
            <label asp-for="LeagueId" class="form-label">League</label>

            <select asp-for="LeagueId" class="form-select" asp-items="ViewBag.LeagueList" disabled>
               
            </select>

            <span asp-validation-for="LeagueId" class="text-danger"></span>
        </div>
        <div class="mb-3">
            <label asp-for="CreatedOn"></label>
            <input asp-for="CreatedOn" class="form-control" />
        </div>

    
        <button type="submit" class="btn btn-primary" style="width:150px">Delete</button>
        <a asp-action="Index" asp-controller="Clubs" class="btn btn-primary" style="width:150px">Back To Clubs</a>

    </div>
</form>
@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}
