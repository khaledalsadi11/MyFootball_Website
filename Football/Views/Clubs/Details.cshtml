
@model Football.Models.Club

@{
    ViewData["Title"] = "Club Details";
}

<div class="container py-5">

    <div class="row justify-content-center">
        <div class="col-xl-10">

            <div class="card border-0 shadow-sm rounded-4 overflow-hidden">

                <!-- Header -->
                <div class="p-4 p-md-5 text-white"
                     style="background:linear-gradient(110deg,#071d3a,#12549a)">

                    <div class="d-flex align-items-center gap-3">

                        <div class="bg-white bg-opacity-25 rounded-circle p-4">
                            <i class="bi bi-shield-fill fs-1"></i>
                        </div>

                        <div>
                            <h2 class="fw-bold mb-2">
                                @Model.Name
                            </h2>

                            <span class="badge bg-light text-primary px-3 py-2">
                                <i class="bi bi-shield-check me-1"></i>
                                Football Club
                            </span>
                        </div>

                    </div>
                </div>

                <!-- Body -->
                <div class="card-body p-4 p-md-5">

                    <h5 class="fw-bold mb-4">
                        <i class="bi bi-info-circle text-primary me-2"></i>
                        Club Information
                    </h5>

                    <!-- Club Information -->
                    <div class="row g-3 mb-5">

                        <div class="col-md-6">
                            <div class="bg-light rounded-3 p-3 h-100">

                                <small class="text-muted">
                                    Club Name
                                </small>

                                <h6 class="fw-bold mt-2 mb-0">
                                    @Model.Name
                                </h6>

                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="bg-light rounded-3 p-3 h-100">

                                <small class="text-muted">
                                    Created On
                                </small>

                                <h6 class="fw-bold mt-2 mb-0">
                                    @Model.CreatedOn.ToString("dd MMM yyyy")
                                </h6>

                            </div>
                        </div>

                    </div>

                    <!-- Players Header -->
                    <div class="d-flex justify-content-between
                                align-items-center flex-wrap gap-2 mb-3">

                        <div>
                            <h5 class="fw-bold mb-1">

                                <i class="bi bi-people-fill text-primary me-2"></i>
                                Club Players

                            </h5>

                            <p class="text-muted small mb-0">
                                Players currently registered with this club
                            </p>
                        </div>

                        <span class="badge bg-primary px-3 py-2">
                            @(Model.Players?.Count ?? 0) Players
                        </span>

                    </div>

                    <!-- Players Table -->
                    <div class="table-responsive academy-table-wrap border rounded-3">

                        <table class="table table-hover align-middle mb-0 academy-table">

                            <thead class="table-dark">
                                <tr>
                                    <th scope="col" class="ps-3">#</th>
                                    <th scope="col">Player Name</th>
                                    <th scope="col">Shirt No.</th>
                                    <th scope="col">Position</th>
                                    <th scope="col">Nationality</th>
                                </tr>
                            </thead>

                            <tbody>

                                @if (Model.Players?.Any() == true)
                                {
                                    int count = 1;

                                    @foreach (var player in Model.Players)
                                    {
                                        <tr>
                                            <td class="ps-3">
                                                @count
                                            </td>

                                            <td class="fw-semibold">
                                                @player.Name
                                            </td>

                                            <td>
                                                <span class="badge bg-primary">
                                                    #@player.ShirtNumber
                                                </span>
                                            </td>

                                            <td>
                                                @player.Position
                                            </td>

                                            <td>
                                                @(player.Nationality?.Country ?? "N/A")
                                            </td>
                                        </tr>

                                        count++;
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="5"
                                            class="text-center text-muted py-4">

                                            <i class="bi bi-people fs-3 d-block mb-2"></i>

                                            No players registered yet.

                                        </td>
                                    </tr>
                                }

                            </tbody>
                        </table>

                    </div>

                    <hr class="my-4" />

                    <!-- Actions -->
                    <div class="d-flex justify-content-between flex-wrap gap-2">

                        <a asp-action="Index"
                           class="btn btn-outline-secondary px-4">

                            <i class="bi bi-arrow-left me-1"></i>
                            Back to Clubs
                        </a>

                        <a asp-action="Edit"
                           asp-route-id="@Model.Id"
                           class="btn btn-primary px-4">

                            <i class="bi bi-pencil-square me-1"></i>
                            Edit Club
                        </a>

                    </div>

                </div>
            </div>
        </div>
    </div>
</div>
