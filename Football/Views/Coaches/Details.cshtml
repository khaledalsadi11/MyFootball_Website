
@model Football.Models.Coach

@{
    ViewData["Title"] = "Coach Details";
}

<div class="container py-4">
    <div class="card border-0 shadow-sm">
        <div class="card-body p-4">

            <h3 class="fw-bold mb-4">
                Coach Details
            </h3>

            <dl class="row">

                <!-- Name -->
                <dt class="col-sm-4">
                    Name
                </dt>

                <dd class="col-sm-8">
                    @Model.Name
                </dd>

                <!-- Club -->
                <dt class="col-sm-4">
                    Club
                </dt>

                <dd class="col-sm-8">
                    @(Model.Club?.Name ?? "-")
                </dd>

                <!-- Nationality -->
                <dt class="col-sm-4">
                    Nationality
                </dt>

                <dd class="col-sm-8">
                    @(Model.Nationality?.Country ?? "-")
                </dd>

                <!-- Teams -->
                <dt class="col-sm-4">
                    Teams
                </dt>

                <dd class="col-sm-8">

                    @if (Model.Teams?.Any() == true)
                    {
                        <ul class="mb-0">

                            @foreach (var team in Model.Teams)
                            {
                                <li>
                                    @team.Name
                                </li>
                            }

                        </ul>
                    }
                    else
                    {
                        <span class="text-muted">
                            Not assigned to any team
                        </span>
                    }

                </dd>

            </dl>

            <!-- Actions -->
            <div class="d-flex gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">

                    <i class="bi bi-pencil-square me-1"></i>
                    Edit Coach
                </a>

                <a asp-action="Index"
                   class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2" aria-hidden="true"></i>

                    Back
                </a>
            </div>

        </div>
    </div>
</div>
