
@model Football.Models.Player

@{
    ViewData["Title"] = "Player Details";
}

<div class="container py-4">
    <div class="card shadow-sm border-0">
        <div class="card-body p-4">

            <h3 class="fw-bold mb-4">Player Details</h3>

            <dl class="row">
                <dt class="col-sm-4">Name</dt>
                <dd class="col-sm-8">@Model.Name</dd>

                <dt class="col-sm-4">Shirt Number</dt>
                <dd class="col-sm-8">@Model.ShirtNumber</dd>

                <dt class="col-sm-4">Position</dt>
                <dd class="col-sm-8">@Model.Position</dd>

                <dt class="col-sm-4">Club</dt>
                <dd class="col-sm-8">@(Model.Club?.Name ?? "-")</dd>

                <dt class="col-sm-4">Team</dt>
                <dd class="col-sm-8">@(Model.Team?.Name ?? "Unassigned")</dd>

                <dt class="col-sm-4">Nationality</dt>
                <dd class="col-sm-8">
                    @(Model.Nationality?.Country ?? "-")
                </dd>
            </dl>

            <a asp-action="Edit"
               asp-route-id="@Model.Id"
               class="btn btn-primary"><i class="bi bi-pencil me-2" aria-hidden="true"></i>
                Edit Player
            </a>

            <a asp-action="Index"
               class="btn btn-outline-secondary"><i class="bi bi-arrow-left me-2" aria-hidden="true"></i>
                Back to Players
            </a>
        </div>
    </div>
</div>
