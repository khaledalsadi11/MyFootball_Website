
@model Football.Models.Attendance

@{
    ViewData["Title"] = "Attendance Details";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div>
                    <h2 class="fw-bold">Attendance Details</h2>
                    <p class="text-muted">Record #@Model.Id</p>
                </div>

                <a asp-action="Edit"
                   asp-route-id="@Model.Id"
                   class="btn btn-primary">
                    <i class="bi bi-pencil me-2"></i>Edit
                </a>
            </div>

            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-body p-4 p-md-5">

                    <div class="row g-4">
                        <div class="col-md-6">
                            <p class="text-muted mb-1">Player</p>
                            <h5 class="fw-bold">
                                @(Model.Player?.Name ?? "Unknown")
                            </h5>
                        </div>

                        <div class="col-md-6">
                            <p class="text-muted mb-1">Training Session</p>
                            <h5 class="fw-bold">
                                @(Model.TrainingSession?.Title ?? "Unknown")
                            </h5>
                        </div>

                        <div class="col-md-6">
                            <p class="text-muted mb-1">Status</p>
                            <h5 class="fw-bold">@Model.Status</h5>
                        </div>

                        <div class="col-md-6">
                            <p class="text-muted mb-1">Session Date</p>
                            <h5 class="fw-bold">
                                @Model.TrainingSession?.StartTime.ToString("dd MMM yyyy")
                            </h5>
                        </div>

                        <div class="col-12">
                            <p class="text-muted mb-1">Notes</p>
                            <div class="bg-light rounded-3 p-3">
                                @(Model.Notes ?? "No notes provided")
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <a asp-action="Records" asp-route-sessionId="@Model.TrainingSessionId"
               class="btn btn-outline-secondary mt-4">
                <i class="bi bi-arrow-left me-2"></i>
                Back to Attendance
            </a>
        </div>
    </div>
</div>
